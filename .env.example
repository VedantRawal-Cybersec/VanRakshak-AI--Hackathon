# VanRakshak AI runtime
VANRAKSHAK_ENV=development
ALLOW_NETWORK=true
REQUEST_TIMEOUT_S=20
CACHE_TTL_S=300

# Free key required for NASA FIRMS live/NRT fire API
FIRMS_MAP_KEY=

# Token required by Protected Planet API v4
PROTECTED_PLANET_TOKEN=

# Override endpoints only when needed
COPERNICUS_STAC_URL=https://stac.dataspace.copernicus.eu/v1
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
SOILGRIDS_URL=https://rest.isric.org/soilgrids/v2.0/properties/query
OVERPASS_URL=https://overpass-api.de/api/interpreter
GDELT_URL=https://api.gdeltproject.org/api/v2/doc/doc
PROTECTED_PLANET_URL=https://api.protectedplanet.net/v4
