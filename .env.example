# VanRakshak AI runtime
VANRAKSHAK_ENV=development
ALLOW_NETWORK=true
REQUEST_TIMEOUT_S=20
CACHE_TTL_S=300
AUTO_INIT_DB=true

# Database / queue
DATABASE_URL=postgresql+psycopg://vanrakshak:vanrakshak_dev_only@postgis:5432/vanrakshak
REDIS_URL=redis://redis:6379/0

# Satellite/catalogue sources
COPERNICUS_STAC_URL=https://stac.dataspace.copernicus.eu/v1
EARTH_SEARCH_URL=https://earth-search.aws.element84.com/v1

# Raster tile service. Browser-visible URL and Docker-internal URL are separate.
TITILER_PUBLIC_URL=http://localhost:8001
TITILER_INTERNAL_URL=http://titiler:8000

# Environmental sources
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
SOILGRIDS_URL=https://rest.isric.org/soilgrids/v2.0/properties/query
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://router.project-osrm.org
GDELT_URL=https://api.gdeltproject.org/api/v2/doc/doc
PROTECTED_PLANET_URL=https://api.protectedplanet.net/v4

# Free key required for NASA FIRMS NRT fire API
FIRMS_MAP_KEY=

# Protected Planet API v4 token
PROTECTED_PLANET_TOKEN=

# Optional Google Earth Engine filters/layers
GOOGLE_CLOUD_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-service-account.json

# ISRO Bhuvan OGC WMS (public thematic service)
BHUVAN_WMS_URL=https://bhuvan-vec2.nrsc.gov.in/bhuvan/wms

# MOSDAC uses the official mdapi client workflow; no passwords are committed.
# https://mosdac.gov.in/downloadapi-manual

# Optional validated Open-CD deep change model runtime
OPENCD_REPO=
OPENCD_CONFIG=
OPENCD_CHECKPOINT=
