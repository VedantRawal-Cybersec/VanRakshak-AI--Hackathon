# VanRakshak AI runtime
VANRAKSHAK_ENV=development
ALLOW_NETWORK=true
REQUEST_TIMEOUT_S=20
CACHE_TTL_S=300
AUTO_INIT_DB=true
MONITOR_LAT=12.3375
MONITOR_LON=75.8069

# Database / queue
DATABASE_URL=postgresql+psycopg://vanrakshak:vanrakshak_dev_only@postgis:5432/vanrakshak
REDIS_URL=redis://redis:6379/0

# Satellite/catalogue sources
COPERNICUS_STAC_URL=https://stac.dataspace.copernicus.eu/v1
EARTH_SEARCH_URL=https://earth-search.aws.element84.com/v1
GIBS_URL=https://gibs.earthdata.nasa.gov
EONET_URL=https://eonet.gsfc.nasa.gov/api/v3

# Raster tile service
TITILER_PUBLIC_URL=http://localhost:8001
TITILER_INTERNAL_URL=http://titiler:8000

# Environmental/open sources
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
SOILGRIDS_URL=https://rest.isric.org/soilgrids/v2.0/properties/query
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
PHOTON_URL=https://photon.komoot.io
OSRM_URL=https://router.project-osrm.org
GDELT_URL=https://api.gdeltproject.org/api/v2/doc/doc
PROTECTED_PLANET_URL=https://api.protectedplanet.net/v4

# Free key: keep the real value only in local/deployment secrets.
FIRMS_MAP_KEY=
PROTECTED_PLANET_TOKEN=

# Optional Google Earth Engine enhancement; the app has credential-free fallbacks.
GOOGLE_CLOUD_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-service-account.json

# ISRO
BHUVAN_WMS_URL=https://bhuvan-vec2.nrsc.gov.in/bhuvan/wms

# Optional validated Open-CD deep change model runtime
OPENCD_REPO=
OPENCD_CONFIG=
OPENCD_CHECKPOINT=
